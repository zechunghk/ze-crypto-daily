TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id
# Optional: run without sending (prints to console)
DRY_RUN=false

# Interactive bot (bot_server.py) — leave empty to allow all chats
# TELEGRAM_CHAT_ID can be comma-separated for multiple users

# RSI alerts via Railway service rsi-alert (/railway.rsi.toml)
# Modes: both | day | swing | auto
# auto = 日內每次都發，波段只喺香港時間 08:00 加發
# RSI_ALERT_MODE=both
# RSI_TOP=30
